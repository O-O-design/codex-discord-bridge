# Discord application credentials.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Allowlist where the bot may read and respond.
# Use comma-separated Discord snowflake IDs.
DISCORD_GUILD_IDS=YOUR_GUILD_ID
DISCORD_CHANNEL_IDS=YOUR_TEXT_CHANNEL_ID
DISCORD_PARENT_CHANNEL_IDS=
DISCORD_THREAD_IDS=

# Optional denylist. These take priority over allowlists.
DISCORD_BLOCKED_CHANNEL_IDS=
DISCORD_BLOCKED_PARENT_CHANNEL_IDS=

# Optional: allow selected bot users to trigger this bridge.
DISCORD_ALLOWED_BOT_AUTHOR_IDS=

# Users allowed to DM with the bridge or receive private replies.
DISCORD_DM_USER_IDS=

# Users allowed to run Codex with CODEX_SANDBOX.
# Everyone else is forced to read-only.
DISCORD_WRITE_USER_IDS=

# Codex CLI.
# macOS can omit this when using Codex.app.
# Windows/Linux usually use codex from PATH.
CODEX_CLI_PATH=
CODEX_SESSION_FILE=state/codex-session
CODEX_SEED_FILE=memory/default-seed.md
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_MS=180000

# Optional: inject frontstage inbox batches into one existing Codex App task.
# Leave empty to keep inbox mode manual.
CODEX_APP_THREAD_ID=
CODEX_APP_RELAY_STATE_FILE=state/frontstage-relay-state.json
CODEX_APP_EVENT_LOG_FILE=logs/app-server-events.ndjson
CODEX_APP_EVENT_LOG_ENABLED=true
CODEX_APP_VISIBLE_EVENT_STREAM_ENABLED=true
CODEX_APP_VISIBLE_EVENT_MIN_INTERVAL_MS=700
CODEX_APP_TURN_TIMEOUT_MS=180000
CODEX_APP_RELAY_POLL_MS=1000
CODEX_APP_RELAY_REPLAY_EXISTING=false
CODEX_APP_RELAY_BASELINE_GRACE_MS=30000

# Discord batching and optional context.
DISCORD_BATCH_WINDOW_MS=1500
DISCORD_SOLO_BATCH_WINDOW_MS=6000
DISCORD_SEMANTIC_HOLD_MS=10000
DISCORD_SEMANTIC_MAX_HOLD_MS=20000
DISCORD_ADDRESS_PATTERNS=
DISCORD_WAKE_ON_ALLOWED_MESSAGE=false
DISCORD_CONTEXT_LIMIT=0
DISCORD_DELIVERY_MODE=codex
DISCORD_INBOX_FILE=state/frontstage-inbox.ndjson
DISCORD_WATCHER_LEASE_FILE=state/discord-watcher-lease.json
DISCORD_WATCHER_ANCHOR_FILE=memory/discord-watcher-anchor.local.md
DISCORD_IMAGE_ATTACHMENT_LIMIT=4
DISCORD_MAX_IMAGE_BYTES=10000000
DISCORD_UPLOAD_LIMIT=4
DISCORD_MAX_UPLOAD_BYTES=25000000
DISCORD_PRIVATE_REPLY_ENABLED=true
DISCORD_DEV_APPROVAL_MODE=heuristic
DISCORD_DEV_APPROVAL_TIMEOUT_MS=600000

# AI-bot loop guard.
DISCORD_BOT_LOOP_MAX_TURNS=4
DISCORD_BOT_LOOP_WINDOW_MS=600000
DISCORD_BOT_LOOP_COOLDOWN_MS=300000

# Local runtime monitor.
BRIDGE_LOG_FILE=logs/bridge.ndjson
BRIDGE_LOG_MESSAGE_LIMIT=800
MONITOR_PORT=3899

# Optional private roster CSV.
MEMBER_ROSTER_FILE=
